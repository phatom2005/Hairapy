# --- DATABASE ---
# Local dev (docker compose up): de trong DB_URL/DB_USERNAME, dung default trong application.properties
#   (tro toi container "db" trong docker-compose.yml)
DB_PASSWORD=your_secure_password_here

# Deploy (Railway BE + Supabase DB): override 3 bien duoi day.
# Dung Session Pooler cua Supabase (port 5432, KHONG dung Transaction pooler port 6543) vi 2 ly do:
#   1. Railway thuong khong ho tro IPv6 -> connect thang vao Supabase (db.<ref>.supabase.co) se fail.
#      Pooler (aws-0-<region>.pooler.supabase.com) luon ho tro IPv4.
#   2. Transaction pooler (6543) khong tuong thich tot voi prepared statement cua Hibernate.
#      Session pooler (5432) hoat dong nhu connection thuong, an toan voi Hikari/Hibernate.
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_USERNAME=postgres.<project-ref>

# --- BACKEND ---
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sentry - de trong la TAT Sentry (mac dinh, khong loi). Khi co Sentry project
# thuc: set SENTRY_DSN=<dsn> VA SENTRY_AUTOCONFIG_EXCLUDE= (rong, bo dong comment)
# de bat lai SentryAutoConfiguration.
# SENTRY_DSN=
# SENTRY_AUTOCONFIG_EXCLUDE=

# --- JWT ---
# Bat buoc, khong co default. Sinh bang: openssl rand -base64 32
JWT_SECRET=doi_thanh_chuoi_bi_mat_it_nhat_32_byte_base64

# --- AI (AILabTools) ---
AILAB_API_KEY=your_ailab_api_key

# --- PAYOS ---
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=Hairapy
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- FRONTEND (Vite) ---
# Backend API base URL — must use VITE_ prefix to be exposed to the browser
VITE_API_URL=http://localhost:8080

# --- CI/CD (GitHub Secrets reference only — do NOT put real values here) ---
# SNYK_TOKEN=your_snyk_api_token
# DOCKERHUB_USERNAME=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_access_token

# --- RATE LIMITING (tùy chọn, chỉ cần set khi deploy Railway thật) ---
# Mặc định 30 lần/phút cho /api/auth/login — đủ rộng cho dev/test local (kể cả qua
# docker-compose dù nó set SPRING_PROFILES_ACTIVE=prod). Trên Railway dashboard (KHÔNG
# phải file .env này), set RATE_LIMIT_LOGIN_CAPACITY=5 để siết chặt chống brute-force thật.
# RATE_LIMIT_LOGIN_CAPACITY=5
